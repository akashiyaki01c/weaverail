{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weaverail",
  "version": "0.1.7",
  "identifier": "com.github.akashiyaki01c.weaverail",
  "build": {
    "beforeDevCommand": "pnpm --filter @weaverail/app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @weaverail/app build",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Weaverail",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
